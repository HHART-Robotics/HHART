# Edit User and paths
# One-off setup as that user, from repo (~/robot1). --system-site-packages keeps rclpy for ROS switch:
#   uv venv --system-site-packages ~/robot1/.venv
#   uv pip install --python ~/robot1/.venv "hhart @ git+https://github.com/HHART-Robotics/HHART.git@vHHART_VERSION#subdirectory=python" -e "software/python[embedded]"
[Unit]
Description=robot1 bridge (embedded)
After=network.target
Conflicts=robot1-ros.service

[Service]
User=robot
# No ROS, drop the source
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash 2>/dev/null; exec /home/robot/robot1/.venv/bin/robot1-bridge --port /dev/ttyS0'
Restart=on-failure
RestartSec=3
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
